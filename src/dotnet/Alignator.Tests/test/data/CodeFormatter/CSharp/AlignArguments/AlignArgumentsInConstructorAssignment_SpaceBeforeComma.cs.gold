namespace TBN.Alignator.Tests.test.data.CodeFormatter.CSharp.AlignArguments;

/// <seealso cref="AlignatorSettingsKey.INT_ALIGN_ARGUMENTS_IN_CONSTRUCTOR"/>
internal class AlignArgumentsInConstructorAssignment_SpaceBeforeComma
{
  private Tyrannosaurus _tRex;
  private Velociraptor _raptor;
  public Triceratops Trice { get; private set; }
  public Brachiosaurus Brachio { get; }

  public AlignArgumentsInConstructorAssignment_SpaceBeforeComma()
  {
    var localPark = new Brachiosaurus("Local", "Herbivore", 100, false, 12) { Description = "Local park" };
    var sortIndex = 1;

    _tRex = new Tyrannosaurus("T-Rex"    , "Carnivore", 8000, true , Diet.Carnivore, "Jurassic Park");
    _raptor = new Velociraptor("Raptor"  , "Carnivore", 150 , true , Diet.Carnivore, "Jurassic Park 2") { Height = 2 };
    Trice = new Triceratops("Trice"      , "Herbivore", 9000, false, Diet.Herbivore) { Height = 3 };
    Brachio = new Brachiosaurus("Brachio", "Herbivore", 6000, false, 250) { Description = "Long neck" };
  }
}

internal class AlignArgumentsInConstructorAssignment_SpaceBeforeComma_Fields
{
  private Tyrannosaurus _tRex = new Tyrannosaurus("T-Rex"                 , "Carnivore", 8000, true , Diet.Carnivore, "Jurassic Park");
  private Velociraptor _raptor = new Velociraptor("Raptor"                , "Carnivore", 150 , true , Diet.Carnivore, "Jurassic Park 2") { Height = 2 };
  public Triceratops Trice { get; private set; } = new Triceratops("Trice", "Herbivore", 9000, false, Diet.Herbivore) { Height = 3 };
  public Brachiosaurus Brachio { get; } = new Brachiosaurus("Brachio"     , "Herbivore", 6000, false, 250) { Description = "Long neck" };
}