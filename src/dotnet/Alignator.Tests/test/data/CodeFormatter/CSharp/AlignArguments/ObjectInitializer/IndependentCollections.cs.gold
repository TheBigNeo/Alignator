namespace TBN.Alignator.Tests.test.data.CodeFormatter.CSharp.AlignArguments.ObjectInitializer;

/// <seealso cref="AlignatorSettingsKey.ALIGN_OBJECT_INITIALIZER_CLOSING_BRACES"/>
/// <seealso cref="TBN.Alignator.Tests.CodeFormatter.CSharp.AlignArguments.ObjectInitializerFormattingTest.TestIndependentCollections"/>
internal class IndependentCollections
{
  static void Paddock()
  {
    Tyrannosaurus[] carnivores =
    [
      new Tyrannosaurus("T-Rex")        { Height = 2 },
      new Tyrannosaurus("Velociraptor") { Height = 1 },
    ];

    Triceratops[] herbivores =
    [
      new Triceratops("Trice")       { Height = 3  },
      new Triceratops("Triceratops") { Height = 30 },
    ];
  }
}