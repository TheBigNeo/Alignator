using static TBN.Alignator.Tests.Data.RecordFactory;

namespace TBN.Alignator.Tests.test.data.CodeFormatter.CSharp.AlignArguments;

/// <seealso cref="AlignatorSettingsKey.ALIGN_WITH_EXPRESSION_ASSIGNMENTS"/>
/// <seealso cref="TBN.Alignator.Tests.CodeFormatter.CSharp.AlignArguments.CSharpQuirkyFormattingTest.TestAlignAssignmentsInWithExpression_IndependentGroups"/>
internal class AlignAssignmentsInWithExpression_IndependentGroups
{
  static void IndominusRex()
  {
    DinosaurRecord indominusRex = GetDinosaurRecord(ParkSettings.Instance)
      with
      {
        Name                     = "Indominus Rex",
        Diet                     = "Carnivore",
        PaddockNumber            = 11,
        DangerLevel              = DangerLevel.Extreme,
        ThermalCamouflageEnabled = true,
      };

    FeedingSchedule feedingSchedule = GetFeedingSchedule(ParkSettings.Instance)
      with
      {
        Time      = "09:00",
        Food      = "Goat",
        Quantity  = 1,
        Recipient = "T-Rex",
      };
  }
}