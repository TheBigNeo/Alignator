<Project>

  <PropertyGroup>
    <!-- See https://www.nuget.org/packages/JetBrains.ReSharper.SDK -->
    <!-- Keep in sync with ProductVersion in gradle.properties -->
    <SdkVersion>2025.3.0.1</SdkVersion>

    <Title>Alignator</Title>
    <Description>Description</Description>

    <Authors>Author</Authors>
    <Copyright>Copyright $([System.DateTime]::Now.Year) Maintainers of Alignator</Copyright>
    <PackageTags>resharper plugin</PackageTags>

    <PackageProjectUrl></PackageProjectUrl>
    <PackageLicenseUrl></PackageLicenseUrl>
    <PackageIcon>alignator-1024.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\docs\branding\png\alignator-1024.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>alignator-1024.png</Link>
    </None>
  </ItemGroup>

</Project>
