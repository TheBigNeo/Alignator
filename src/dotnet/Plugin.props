<Project>

  <PropertyGroup>
    <!-- See https://www.nuget.org/packages/JetBrains.ReSharper.SDK -->
    <!-- Keep in sync with ProductVersion in gradle.properties -->
    <SdkVersion>2025.3.0.1</SdkVersion>

    <Title>Alignator</Title>
    <Description>Vertically aligns arguments in C# code: arguments of constructor, function and attribute calls, values of named arguments, dictionary-style entries in collection initializers, and assignments in with expressions. Works through the ReSharper column-alignment engine; every alignment has its own setting (.editorconfig: csharp_alignator_*).</Description>

    <Authors>TheBigNeo</Authors>
    <Copyright>Copyright $([System.DateTime]::Now.Year) Maintainers of Alignator</Copyright>
    <PackageTags>resharper plugin</PackageTags>

    <PackageProjectUrl>https://github.com/TheBigNeo/Alignator</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>alignator-1024.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\..\docs\branding\png\alignator-1024.png">
      <Pack>True</Pack>
      <PackagePath></PackagePath>
      <Link>alignator-1024.png</Link>
    </None>
  </ItemGroup>

</Project>
